<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<scenario name="Dialog Auto PRACK Multi-ToTag UAS Early To-Tag">
  <recv request="INVITE" crlf="true" rrs="true">
    <action>
      <ereg regexp=".+" search_in="hdr" header="Via:" check_it="true" assign_to="hdr_via"/>
      <ereg regexp=".*" search_in="hdr" header="From:" assign_to="hdr_from"/>
      <ereg regexp=".*" search_in="hdr" header="To:" assign_to="hdr_to"/>
      <ereg regexp=".*" search_in="hdr" header="CSeq:" assign_to="hdr_cseq"/>
    </action>
  </recv>

  <send>
    <![CDATA[

      SIP/2.0 100 Trying
      Via:[$hdr_via]
      From:[$hdr_from]
      To:[$hdr_to];tag=[service].[call_number]
      [last_Call-ID:]
      CSeq:[$hdr_cseq]
      Contact: <sip:[local_ip]:[local_port]>
      Content-Length: 0

    ]]>
  </send>

  <pause milliseconds="1" />

  <send>
    <![CDATA[

      SIP/2.0 180 Ringing
      Via:[$hdr_via]
      From:[$hdr_from]
      To:[$hdr_to];tag=desk.[call_number]
      [last_Call-ID:]
      CSeq:[$hdr_cseq]
      Require: 100rel
      RSeq: 1
      Contact: <sip:[local_ip]:[local_port]>
      Content-Length: 0

    ]]>
  </send>

  <recv request="PRACK" crlf="true">
    <action>
      <ereg regexp=".*tag=desk\\.[0-9]+" search_in="hdr" header="To:" check_it="true" assign_to="prack_to_desk"/>
    </action>
  </recv>

  <send>
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      [last_Record-Route:]
      Content-Length: 0

    ]]>
  </send>

  <pause milliseconds="200" />

  <send>
    <![CDATA[

      SIP/2.0 180 Ringing
      Via:[$hdr_via]
      From:[$hdr_from]
      To:[$hdr_to];tag=mobile.[call_number]
      [last_Call-ID:]
      CSeq:[$hdr_cseq]
      Require: 100rel
      RSeq: 2
      Contact: <sip:[local_ip]:[local_port]>
      Content-Length: 0

    ]]>
  </send>

  <recv request="PRACK" crlf="true">
    <action>
      <ereg regexp=".*tag=mobile\\.[0-9]+" search_in="hdr" header="To:" check_it="true" assign_to="prack_to_mobile"/>
    </action>
  </recv>

  <send>
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      [last_Record-Route:]
      Content-Length: 0

    ]]>
  </send>

  <send retrans="500">
    <![CDATA[

      SIP/2.0 200 OK
      Via:[$hdr_via]
      From:[$hdr_from]
      To:[$hdr_to];tag=mobile.[call_number]
      [last_Call-ID:]
      CSeq:[$hdr_cseq]
      [last_Record-Route:]
      Contact: <sip:[local_ip]:[local_port]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=user1 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0
      a=rtpmap:0 PCMU/8000

    ]]>
  </send>

  <!-- the call was answered on the "mobile" to-tag: the ACK and the BYE must
       arrive on it, with the INVITE CSeq for the ACK, even though the UAC
       sent them with the "desk" to-tag of the first 180 -->
  <recv request="ACK" crlf="true">
    <action>
      <ereg regexp=".*tag=mobile\\.[0-9]+" search_in="hdr" header="To:" check_it="true" assign_to="ack_to_mobile"/>
      <ereg regexp="(^|[^0-9])1 ACK" search_in="hdr" header="CSeq:" check_it="true" assign_to="ack_cseq"/>
    </action>
  </recv>
  <recv request="BYE" crlf="true" rrs="true">
    <action>
      <ereg regexp=".*tag=mobile\\.[0-9]+" search_in="hdr" header="To:" check_it="true" assign_to="bye_to_mobile"/>
    </action>
  </recv>

  <send retrans="500">
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      [last_Record-Route:]
      Contact: <sip:[local_ip]:[local_port]>
      Content-Length: 0

    ]]>
  </send>

  <ResponseTimeRepartition value="200, 500" />
  <CallLengthRepartition value="500, 1000, 2000" />
  <Reference variables="hdr_via,hdr_from,hdr_to,hdr_cseq,prack_to_mobile,prack_to_desk,ack_to_mobile,ack_cseq,bye_to_mobile" />
</scenario>
