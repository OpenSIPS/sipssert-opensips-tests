<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<scenario name="Multipart parser UAS">
  <recv request="INVITE" crlf="true">
    <action>
      <ereg regexp="multipart/mixed" search_in="hdr" header="Content-Type:" check_it="true" assign_to="dummy"/>
    </action>
  </recv>

  <send retrans="500">
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[service].[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port]>
      Content-Length: 0

    ]]>
  </send>

  <recv request="ACK" crlf="true">
  </recv>

  <ResponseTimeRepartition value="500, 1000, 1500, 2000"/>
  <CallLengthRepartition value="500"/>

  <Reference variables="dummy" />

</scenario>
